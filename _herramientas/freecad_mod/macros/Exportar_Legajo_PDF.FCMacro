# -*- coding: utf-8 -*-
"""
Macro FreeCAD: Exportar_Legajo_PDF.FCMacro
Exporta todas las láminas de dibujo técnico (TechDraw::DrawPage) sin trabar la interfaz Qt,
procesando cada hoja una por una (cerrando pestañas o documentos entre iteraciones para liberar RAM)
y uniéndolas al final en un único archivo PDF consolidado mediante `pdfunite` / `qpdf`.

Soporta dos modos automáticamente:
1. Si existe la carpeta `planos/hojas/*.FCStd`, abre cada lámina individual en orden,
   la exporta a PDF y cierra el documento antes de pasar a la siguiente (consumo mínimo de memoria).
2. Si se ejecuta sobre un documento multipágina abierto, muestra/exporta/oculta cada página
   de una en una con `Gui.updateGui()` para no saturar Qt.
"""
import glob
import os
import shutil
import subprocess
import FreeCAD as App
import FreeCADGui as Gui
import TechDrawGui


def _orden_hoja(nombre_o_page):
    if isinstance(nombre_o_page, str):
        return os.path.basename(nombre_o_page)
    et = getattr(getattr(nombre_o_page, "Template", None), "EditableTexts", {})
    hoja_txt = et.get("HOJA", "")
    if "/" in hoja_txt:
        try:
            return f"{int(hoja_txt.split('/')[0]):04d}_{nombre_o_page.Name}"
        except Exception:
            pass
    return nombre_o_page.Name


def _unir_pdfs(lista_pdfs, ruta_salida):
    if not lista_pdfs:
        return False
    cmd = None
    if shutil.which("pdfunite"):
        cmd = ["pdfunite"] + lista_pdfs + [ruta_salida]
    elif shutil.which("qpdf"):
        cmd = ["qpdf", "--empty", "--pages"] + lista_pdfs + ["--", ruta_salida]
    if not cmd:
        App.Console.PrintError("No se encontró 'pdfunite' ni 'qpdf' para unir los PDFs.\n")
        return False
    subprocess.run(cmd, check=True)
    return os.path.exists(ruta_salida)


def _exportar_pagina_gui(pag, ruta_pdf):
    vo = getattr(pag, "ViewObject", None)
    if vo:
        try:
            vo.show()
        except Exception:
            pass
    Gui.updateGui()
    TechDrawGui.exportPageAsPdf(pag, ruta_pdf)
    Gui.updateGui()
    if vo:
        try:
            vo.hide()
        except Exception:
            pass


doc = App.ActiveDocument
dir_base = os.path.dirname(getattr(doc, "FileName", "")) if doc and getattr(doc, "FileName", "") else ""

# Buscar carpeta de hojas individuales (planos/hojas/) si existe junto al documento o dentro de planos/
dir_hojas = ""
if dir_base:
    if os.path.basename(dir_base) == "hojas":
        dir_hojas = dir_base
        dir_planos = os.path.dirname(dir_base)
    elif os.path.isdir(os.path.join(dir_base, "hojas")):
        dir_hojas = os.path.join(dir_base, "hojas")
        dir_planos = dir_base
    else:
        dir_planos = dir_base
else:
    dir_planos = os.path.expanduser("~")

dir_pdf_ind = os.path.join(dir_planos, "pdf")
os.makedirs(dir_pdf_ind, exist_ok=True)
ruta_pdf_final = os.path.join(dir_planos, "Planos_Bomba_Flujo_Cardiaco_Completo.pdf")

pdfs_generados = []

if dir_hojas and glob.glob(os.path.join(dir_hojas, "Plano_*.FCStd")):
    archivos_fcstd = sorted(glob.glob(os.path.join(dir_hojas, "Plano_*.FCStd")), key=_orden_hoja)
    App.Console.PrintMessage(f"Exportando {len(archivos_fcstd)} hojas individuales una por una...\n")

    for idx, fpath in enumerate(archivos_fcstd, start=1):
        stem = os.path.splitext(os.path.basename(fpath))[0]
        ruta_hoja_pdf = os.path.join(dir_pdf_ind, f"{idx:02d}_{stem}.pdf")
        ya_abierto = any(
            os.path.abspath(getattr(d, "FileName", "")) == os.path.abspath(fpath)
            for d in App.listDocuments().values()
        )
        d_hoja = None
        try:
            d_hoja = App.openDocument(fpath)
            Gui.setActiveDocument(d_hoja.Name)
            Gui.updateGui()
            pag = next((o for o in d_hoja.Objects if o.TypeId == "TechDraw::DrawPage"), None)
            if pag:
                _exportar_pagina_gui(pag, ruta_hoja_pdf)
                if os.path.exists(ruta_hoja_pdf):
                    pdfs_generados.append(ruta_hoja_pdf)
                    App.Console.PrintMessage(f"  [{idx}/{len(archivos_fcstd)}] OK: {stem}.pdf\n")
        except Exception as e:
            App.Console.PrintWarning(f"  Error exportando {stem}: {e}\n")
        finally:
            if d_hoja and not ya_abierto:
                try:
                    App.closeDocument(d_hoja.Name)
                except Exception:
                    pass
elif doc:
    paginas = [o for o in doc.Objects if o.TypeId == "TechDraw::DrawPage"]
    if not paginas:
        App.Console.PrintError("El documento activo no contiene páginas de TechDraw.\n")
    else:
        paginas_ord = sorted(paginas, key=_orden_hoja)
        App.Console.PrintMessage(f"Exportando {len(paginas_ord)} páginas secuencialmente (liberando pestañas)...\n")
        for idx, pag in enumerate(paginas_ord, start=1):
            ruta_hoja_pdf = os.path.join(dir_pdf_ind, f"{idx:02d}_{pag.Name}.pdf")
            try:
                _exportar_pagina_gui(pag, ruta_hoja_pdf)
                if os.path.exists(ruta_hoja_pdf):
                    pdfs_generados.append(ruta_hoja_pdf)
                    App.Console.PrintMessage(f"  [{idx}/{len(paginas_ord)}] OK: {pag.Name}.pdf\n")
            except Exception as e:
                App.Console.PrintWarning(f"  Error exportando {pag.Name}: {e}\n")
else:
    App.Console.PrintError("Abre cualquiera de los planos en FreeCAD antes de ejecutar esta macro.\n")

if pdfs_generados:
    try:
        if _unir_pdfs(pdfs_generados, ruta_pdf_final):
            tam_mb = os.path.getsize(ruta_pdf_final) / (1024.0 * 1024.0)
            App.Console.PrintMessage(
                f"\n>>> ÉXITO: {len(pdfs_generados)} láminas consolidadas ({tam_mb:.2f} MB) en:\n"
                f"    {ruta_pdf_final}\n\n"
            )
            if hasattr(Gui, "getMainWindow") and Gui.getMainWindow():
                Gui.getMainWindow().statusBar().showMessage(
                    f"PDF único generado ({len(pdfs_generados)} hojas, {tam_mb:.2f} MB)", 8000
                )
    except Exception as e:
        App.Console.PrintError(f"Error uniendo PDFs con pdfunite/qpdf: {e}\n")
